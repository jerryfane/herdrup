<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Upload variant of the export options. `destination: upload` makes
  `xcodebuild -exportArchive` distribution-sign AND upload to App Store Connect in
  one step, authenticated by the Mac's SIGNED-IN XCODE ACCOUNT (no API key, no
  deprecated `xcrun altool`). Used by scripts/testflight.sh only when
  TESTFLIGHT_UPLOAD=1. See docs/testflight-lane.md.
-->
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store-connect</string>
  <key>destination</key>
  <string>upload</string>
  <key>teamID</key>
  <string>FXQ5Z9HHY6</string>
  <key>signingStyle</key>
  <string>automatic</string>
  <key>uploadSymbols</key>
  <true/>
  <key>manageAppVersionAndBuildNumber</key>
  <false/>
</dict>
</plist>
