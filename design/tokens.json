{
  "schema_version": 1,
  "_comment": "Shared design tokens for the Herdrup iOS/iPad/Mac app and Herdrup Desktop. See design/README.md. Colours are \"#RRGGBB\" strings. A string of the form \"{group.path}\" is a reference to another token by its path; every other string is a literal. Keys are the Swift names, so Tools/tokens/generate.py maps them 1:1 into App/Generated/DesignTokens.swift; the desktop turns paths into CSS variables (color.dark.textDim -> --color-text-dim). color.light is null: the app is dark-only. type.*.font and text.*.font name a key of font. space, radius and size are points; text.* sizes and tracking are points at text scale 1 and weights are CSS weights.",
  "color": {
    "dark": {
      "ground": "#13162A",
      "groundMachine": "#0B0D1C",
      "surface": "#1D2038",
      "surfaceRaised": "#262A45",
      "hairline": "#2E3358",
      "hairlineQuiet": "#232742",
      "text": "#EEF0F7",
      "textDim": "#99A0BC",
      "textFaint": "#666D91",
      "brand": "#7A6FF0",
      "onAccent": "#FFFFFF",
      "onAccentDimOpacity": 0.82
    },
    "light": null
  },
  "status": {
    "waiting": "#E9A63C",
    "died": "#E2584E",
    "working": "#5B9BE8",
    "done": "#5FB37F"
  },
  "group": {
    "needsYou": "{status.waiting}",
    "stopped": "{status.died}",
    "unrecognised": "{status.waiting}",
    "working": "{status.working}",
    "idle": "{color.dark.textFaint}"
  },
  "agentGradient": {
    "claude": ["#CE58A4", "#A32E77"],
    "codex": ["#E8923C", "#C5622A"],
    "gemini": ["#4C6EF5", "#2E44C4"],
    "default": ["#8B79F6", "#5B44C9"]
  },
  "chat": {
    "dark": {
      "heading": "#BB9AF7", "toolTitle": "#BB9AF7",
      "codeText": "#A9B1D6", "codeBackground": "#16161E", "codeBorder": "#363B54",
      "keyword": "#BB9AF7", "string": "#9ECE6A", "comment": "#51597D", "function": "#7AA2F7",
      "number": "#FF9E64", "type": "#0DB9D7", "op": "#A9B1D6",
      "inserted": "#9ECE6A", "deleted": "#F7768E"
    },
    "light": {
      "heading": "#B15C00", "toolTitle": "#3760BF",
      "codeText": "#6172B0", "codeBackground": "#E1E2E7", "codeBorder": "#B4B5B9",
      "keyword": "#7847BD", "string": "#587539", "comment": "#848CB5", "function": "#2E7DE9",
      "number": "#B15C00", "type": "#007197", "op": "#9854F1",
      "inserted": "#587539", "deleted": "#C64343"
    }
  },
  "font": {
    "app": {
      "family": "Geist",
      "fallback": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "system-ui", "sans-serif"],
      "faces": {
        "400": { "postscript": "Geist-Regular", "file": "App/Fonts/Geist-Regular.ttf" },
        "500": { "postscript": "Geist-Medium", "file": "App/Fonts/Geist-Medium.ttf" },
        "600": { "postscript": "Geist-SemiBold", "file": "App/Fonts/Geist-SemiBold.ttf" },
        "700": { "postscript": "Geist-Bold", "file": "App/Fonts/Geist-Bold.ttf" }
      },
      "license": "App/Fonts/Geist-OFL.txt"
    },
    "machine": {
      "family": "IBM Plex Mono",
      "fallback": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"],
      "faces": {
        "400": { "postscript": "IBMPlexMono", "file": "App/Fonts/IBMPlexMono-Regular.ttf" },
        "500": { "postscript": "IBMPlexMono-Medm", "file": "App/Fonts/IBMPlexMono-Medium.ttf" },
        "600": { "postscript": "IBMPlexMono-SmBld", "file": "App/Fonts/IBMPlexMono-SemiBold.ttf" },
        "700": { "postscript": "IBMPlexMono-Bold", "file": "App/Fonts/IBMPlexMono-Bold.ttf" }
      },
      "license": "App/Fonts/IBMPlexMono-OFL.txt"
    },
    "system": {
      "_comment": "The platform UI font: San Francisco on Apple platforms. Owner decision 2026-10-28: herdrup keeps San Francisco and SF Symbols; the desktop matches it exactly on Mac and uses the nearest open font elsewhere. No faces: the platform draws every weight.",
      "family": "system",
      "fallback": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Inter", "system-ui", "sans-serif"]
    }
  },
  "type": {
    "microLabel": {
      "font": "{text.microLabel.font}",
      "size": "{text.microLabel.size}",
      "weight": "{text.microLabel.weight}",
      "uppercase": "{text.microLabel.uppercase}"
    }
  },
  "space": {
    "rowLead": 20,
    "rowLeadIndented": 44,
    "avatarGap": 12,
    "rowTrail": 16,
    "screenInset": 16,
    "stackTight": 2,
    "stackSmall": 6,
    "stackMedium": 8,
    "stackLarge": 12
  },
  "radius": {
    "selection": 12,
    "card": 14,
    "group": 18,
    "tile": 10,
    "badgeSquare": 6
  },
  "size": {
    "agentRow": 80,
    "agentRowPhone": 86,
    "disclosureRow": 48,
    "avatarSidebar": 44,
    "avatarPhone": 52,
    "avatarGlyphSidebar": 19,
    "avatarGlyphPhone": 22,
    "statusBadge": 22,
    "statusBadgeStroke": 2.5,
    "statusBadgeOffset": 4,
    "selectionInset": 6,
    "topBar": 50,
    "topBarRow": 44,
    "searchField": 42,
    "needsYouPill": 44,
    "needsYouAvatar": 32,
    "tabBar": 62,
    "tabBarMaxWidth": 320,
    "sidebarMin": 320,
    "sidebarMax": 460,
    "machineCardAvatar": 60,
    "rail": 64,
    "hairline": 1
  },
  "text": {
    "barTitle":        { "font": "app",     "size": 17, "weight": 600 },
    "rowName":         { "font": "system",  "size": 16, "weight": 600 },
    "rowNamePhone":    { "font": "system",  "size": 17, "weight": 600 },
    "rowPreview":      { "font": "system",  "size": 14, "weight": 400 },
    "rowPreviewPhone": { "font": "system",  "size": 15, "weight": 400 },
    "rowAge":          { "font": "app",     "size": 14, "weight": 400, "tabular": true },
    "rowAgePhone":     { "font": "app",     "size": 15, "weight": 400, "tabular": true },
    "accountLabel":    { "font": "machine", "size": 11, "weight": 400 },
    "markerPill":      { "font": "app",     "size": 11, "weight": 600 },
    "disclosureTitle": { "font": "app",     "size": 17, "weight": 400 },
    "disclosureCount": { "font": "app",     "size": 15, "weight": 400, "tabular": true },
    "search":          { "font": "app",     "size": 16, "weight": 400 },
    "pillName":        { "font": "app",     "size": 15, "weight": 600 },
    "pillDetail":      { "font": "app",     "size": 14, "weight": 400 },
    "countPill":       { "font": "app",     "size": 13, "weight": 700, "tabular": true },
    "cardTitle":       { "font": "app",     "size": 16, "weight": 600 },
    "cardSubtitle":    { "font": "machine", "size": 12, "weight": 400 },
    "machineCardTitle": { "font": "app",    "size": 20, "weight": 600 },
    "machineHeroTitle": { "font": "app",    "size": 24, "weight": 700 },
    "tabLabel":        { "font": "system",  "size": 10, "weight": 600 },
    "badgeCount":      { "font": "system",  "size": 11, "weight": 600, "tabular": true },
    "placeholder":     { "font": "app",     "size": 15, "weight": 500 },
    "empty":           { "font": "app",     "size": 15, "weight": 400 },
    "microLabel":      { "font": "machine", "size": 11, "weight": 600, "uppercase": true, "tracking": 1.2 }
  }
}
